# Portfolio assistant (Atlas)
# ---------------------------------------------------------------------------
# OPTIONAL. With NO key set, /api/chat serves intelligent, fully-grounded
# answers from the local knowledge base (no cost, no network). Set this to
# upgrade to live Claude-powered responses.
#
# Get a key at https://console.anthropic.com  -> then add it in Vercel:
#   Project -> Settings -> Environment Variables -> ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Optional model override (defaults to claude-3-5-haiku-latest -- fast + cheap).
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
